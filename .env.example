# Google Sheets automation configuration
SHEET_ID=<your-google-sheet-id>
SHEET_RANGE=Sheet1!A1:D
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
ADMIN_API_URL=https://admin.travelbase.eu/task/export
ADMIN_API_METHOD=POST
ADMIN_API_TOKEN=<your-api-token>
# ADMIN_API_BODY can be a JSON payload for POST requests, e.g. '{"startDate":"2026-01-01"}'
# ADMIN_API_BODY={}
